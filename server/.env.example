# Пример переменных окружения Kadra Server (скопируйте в .env для локального запуска)

# Каталог данных: SQLite-база и медиафайлы (на Render — смонтированный диск /var/data)
DATA_DIR=./data

# Секрет для подписи JWT. Обязательно задайте в продакшене (32+ случайных символа).
# Если не задан — сгенерируется и сохранится в DATA_DIR/.secret_key
SECRET_KEY=

# Разрешённые origin фронтенда через запятую. * — любой (удобно для разработки)
CORS_ORIGINS=*

# PostgreSQL вместо SQLite (необязательно), формат postgres://user:pass@host:5432/db
DATABASE_URL=

# Где хранить медиа (по умолчанию DATA_DIR/assets)
STORAGE_DIR=

# Максимальный размер одного загружаемого файла, МБ (защита диска сервера)
MAX_UPLOAD_MB=4096

# Время жизни токена входа, часы
TOKEN_TTL_HOURS=720

# Разрешить регистрацию новых пользователей
ALLOW_REGISTRATION=true

# Раздавать фронтенд с этого же сервера (необязательно): путь к каталогу web
FRONTEND_DIR=
